CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_PROJECT_KEY=
CTP_SCOPE=
CTP_REGION=us-central1.gcp

# The shared secret commercetools presents on every call to this endpoint.
# At least 24 characters, and the same value the Extension is registered with.
EXTENSION_AUTH_SECRET=

# Connect injects this; set it by hand only when running the endpoint
# somewhere else, such as behind a tunnel.
CONNECT_SERVICE_URL=

RULE_CACHE_SECONDS=10
EXTENSION_TIMEOUT_MS=2000
