CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_PROJECT_KEY=
CTP_SCOPE=
CTP_REGION=us-central1.gcp

# Merchant Center API region; the issuer of the session token this API
# verifies. gcp-us, gcp-eu, gcp-au, aws-eu, aws-us, aws-fra or aws-ohio.
CLOUD_IDENTIFIER=gcp-us

# Origin the Merchant Center reaches this API at. Connect injects
# CONNECT_SERVICE_URL; set PUBLIC_API_URL instead when developing behind a
# tunnel, and make it match the tunnel's https origin exactly.
PUBLIC_API_URL=

VIEW_PERMISSION=canViewAutoCategorization
MANAGE_PERMISSION=canManageAutoCategorization

SWEEP_PAGE_SIZE=100
SWEEP_MAX_PAGES=10
SWEEP_BUDGET_SECONDS=20
